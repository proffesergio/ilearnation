# All integrations default to off. Use apps/web/.env.local for the web app.
# Only a 40-character reviewed commit SHA is accepted for GitHub lesson reads.
COURSE_SOURCE=local
COURSE_GITHUB_REF=
# No GitHub write credential is needed by the website.
# The admin is a local draft preview, not a production authorization system.
ADMIN_PREVIEW=false
# Mapbox MCP authorization does not supply a browser token or approve map-load costs.
# A live Mapbox renderer is deferred until connection and runtime scope are verified.
