# Copy to apps/web/.env.local. Never commit local values.
COURSE_SOURCE=local
COURSE_GITHUB_REF=
SITE_URL=http://127.0.0.1:3000

# Explicit durable local mode. Use an ignored path; Node.js 24 required.
DATABASE_MODE=sqlite
LOCAL_DATABASE_PATH=.local-data/learning.sqlite
# For Neon instead, set DATABASE_MODE=neon and a server-side connection string.
DATABASE_URL=

# Auth.js. Generate a unique secret of at least 32 characters locally.
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local production-start loopback tests only; never set on Vercel.
ALLOW_INSECURE_LOCAL_AUTH=false
# Only for an explicitly managed persistent non-Vercel SQLite host.
ALLOW_SQLITE_PRODUCTION=false
