{
  "name": "@field-notes/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand",
    "check": "node --check src/app.mjs && node --check src/store.mjs && node --check src/server.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "jose": "^6.1.0",
    "mongoose": "^9.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "socket.io-client": "^4.8.1"
  },
  "jest": { "testEnvironment": "node", "transform": {}, "testMatch": ["**/test/**/*.test.mjs"] }
}
